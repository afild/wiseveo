# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal agent files (credentials, scratch)
.agent/test-credentials.md

# Claude Code — config pessoal (nao versionar)
.claude/settings.local.json

# Labs — referencias de design locais (nao versionar)
src/labs/

# Catalogo local de commits (descricoes reais; publico so ve mensagem generica)
docs/commit-catalog.local.md

# Registro local da faxina manual da demo (scripts/clean-demo-visitors.ts)
clean-demo-visitors.log
progresso-demo.log
recover-demo-db.log

# Snapshots do fechamento de datas (scripts/close-dates.ts) — a linha do dono, nunca versionar
backups/
